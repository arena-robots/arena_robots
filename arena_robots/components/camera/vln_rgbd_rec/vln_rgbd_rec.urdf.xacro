<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">
  <!-- vln_rgbd unchanged, plus a 640x480 / 30 Hz RGB camera on the same frame and a third-person
       chase camera behind the robot, for episode videos only. -->
  <xacro:include filename="$(find arena_robots)/components/camera/vln_rgbd/vln_rgbd.urdf.xacro" />
  <xacro:include filename="$(find arena_robots)/components/camera/chase_rec/chase_rec.urdf.xacro" />

  <xacro:macro name="vln_rgbd_rec" params="name parent_link sensor topic height *origin rec_width:=640 rec_height:=480 rec_rate:=30">
    <xacro:vln_rgbd name="${name}" parent_link="${parent_link}" sensor="${sensor}" topic="${topic}" height="${height}">
      <xacro:insert_block name="origin" />
    </xacro:vln_rgbd>

    <xacro:property name="M_PI" value="3.1415926535897931" />
    <gazebo reference="${name}_rgb_camera_frame">
      <sensor name="${sensor}_rec_camera" type="camera">
        <gz_frame_id>$(arg sim_path)/${name}_rgb_camera_frame</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>${rec_rate}</update_rate>
        <visualize>false</visualize>
        <topic>${topic}/rec_image</topic>
        <camera>
          <horizontal_fov>${M_PI/2}</horizontal_fov>
          <image>
            <width>${rec_width}</width>
            <height>${rec_height}</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.01</near>
            <far>100.0</far>
          </clip>
        </camera>
      </sensor>
    </gazebo>
    <xacro:chase_rec name="${name}" parent_link="${parent_link}" sensor="${sensor}" topic="${topic}" />
  </xacro:macro>
</robot>
